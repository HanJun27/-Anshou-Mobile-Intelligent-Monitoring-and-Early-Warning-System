<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 睡眠监测总开关 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="睡眠监测"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchSleepMonitor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="开启后监测睡眠状态，识别异常起床"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 睡眠模式选择卡片（受总开关控制） -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSleepMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="监测模式"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>

                <RadioGroup
                    android:id="@+id/radioGroupSleepMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioPowerSaving"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="省电模式"
                        android:textSize="14sp"/>

                    <RadioButton
                        android:id="@+id/radioBalanced"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="均衡模式"
                        android:textSize="14sp"
                        android:checked="true"/>

                </RadioGroup>

                <TextView
                    android:id="@+id/tvModeDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="均衡模式：使用加速度计检测体动，精准度更高"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="12dp"
                    android:padding="8dp"
                    android:background="@color/primary_light"/>

                <!-- 陀螺仪增强开关（仅均衡模式显示） -->
                <LinearLayout
                    android:id="@+id/layoutGyro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="陀螺仪增强"
                        android:textSize="14sp"/>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchGyro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 起床时间设置卡片 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardWakeTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="预设起床时间"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_edit"
                        android:contentDescription="编辑"
                        android:alpha="0.6"/>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="点击设置起床时间和晚起容忍时长"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 阈值设置卡片 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardThresholds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="阈值设置"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="16dp"/>

                <!-- 无活动判定时间 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="无活动判定时间（分钟）"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btnInactiveMinus"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:text="-"
                        android:textSize="18sp"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>

                    <TextView
                        android:id="@+id/tvInactiveValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="30"
                        android:textSize="18sp"
                        android:textAlignment="center"
                        android:textStyle="bold"/>

                    <Button
                        android:id="@+id/btnInactivePlus"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:text="+"
                        android:textSize="18sp"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>

                </LinearLayout>

                <!-- 步数增长阈值 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="步数增长阈值（步）"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btnStepMinus"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:text="-"
                        android:textSize="18sp"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>

                    <TextView
                        android:id="@+id/tvStepValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="10"
                        android:textSize="18sp"
                        android:textAlignment="center"
                        android:textStyle="bold"/>

                    <Button
                        android:id="@+id/btnStepPlus"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:text="+"
                        android:textSize="18sp"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>

                </LinearLayout>

                <!-- 加速度阈值（仅在均衡模式显示） -->
                <LinearLayout
                    android:id="@+id/layoutAccelThreshold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="加速度变化阈值（m/s²）"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnAccelMinus"
                            android:layout_width="56dp"
                            android:layout_height="48dp"
                            android:text="-"
                            android:textSize="18sp"
                            style="@style/Widget.Material3.Button.OutlinedButton"/>

                        <TextView
                            android:id="@+id/tvAccelValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1.5"
                            android:textSize="18sp"
                            android:textAlignment="center"
                            android:textStyle="bold"/>

                        <Button
                            android:id="@+id/btnAccelPlus"
                            android:layout_width="56dp"
                            android:layout_height="48dp"
                            android:text="+"
                            android:textSize="18sp"
                            style="@style/Widget.Material3.Button.OutlinedButton"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 睡眠历史数据 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSleepHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="睡眠学习数据"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvAvgSleepTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="平均睡眠时长：计算中..."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"/>

                <Button
                    android:id="@+id/btnViewHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="查看详细历史"
                    android:layout_marginTop="12dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>