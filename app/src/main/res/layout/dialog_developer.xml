<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="开发者测试界面"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- 场景选择 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="测试场景"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <RadioGroup
                    android:id="@+id/radioGroupScenario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/radioNormal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="正常情况（不触发）"
                        android:padding="8dp"/>

                    <RadioButton
                        android:id="@+id/radioNoSign"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="未签到 + 设备使用时间短"
                        android:padding="8dp"/>

                    <RadioButton
                        android:id="@+id/radioLowUsage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="设备使用时间短（但已签到）"
                        android:padding="8dp"/>

                    <RadioButton
                        android:id="@+id/radioLowStep"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="步数不足"
                        android:padding="8dp"/>

                    <RadioButton
                        android:id="@+id/radioSleepAbnormal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="起床异常"
                        android:padding="8dp"/>

                    <RadioButton
                        android:id="@+id/radioMixed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="多维度异常"
                        android:padding="8dp"/>

                </RadioGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 手动设置数据 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="手动设置数据"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <!-- 签到状态 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="签到状态："
                        android:textSize="14sp"/>

                    <RadioGroup
                        android:id="@+id/radioGroupSign"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/radioSigned"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="已签到"/>

                        <RadioButton
                            android:id="@+id/radioNotSigned"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="未签到"
                            android:checked="true"/>

                    </RadioGroup>

                </LinearLayout>

                <!-- 开机时间 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="开机时间："
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/etBootTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:hint="小时"
                        android:text="0.5"/>

                </LinearLayout>

                <!-- 应用使用时间 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="应用使用："
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/etAppUsage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:hint="分钟"
                        android:text="3"/>

                </LinearLayout>

                <!-- 步数 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="今日步数："
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/etStepCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:hint="步"
                        android:text="50"/>

                </LinearLayout>

                <!-- 起床时间（用于测试睡眠异常） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="起床时间："
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/etWakeHour"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:hint="时"
                        android:text="10"
                        android:layout_marginEnd="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textSize="16sp"/>

                    <EditText
                        android:id="@+id/etWakeMinute"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:hint="分"
                        android:text="30"
                        android:layout_marginStart="4dp"/>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 后台运行时间 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="后台运行时间"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/tvRunTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 小时 0 分钟"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/tvLastAliveTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="最后存活检查：未知"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 测试按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnTestSms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="测试短信"
                android:layout_marginEnd="8dp"
                style="@style/Widget.Material3.Button.OutlinedButton"/>

            <Button
                android:id="@+id/btnTestEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="测试邮件"
                style="@style/Widget.Material3.Button.OutlinedButton"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnTriggerAlert"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="触发警报"
                android:backgroundTint="@color/error"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="重置"
                style="@style/Widget.Material3.Button.OutlinedButton"/>

        </LinearLayout>
<!-- ✅ 新增：社区守护测试按钮 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="社区守护测试"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnSendSimulatedAlert"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="发送模拟警报"
                android:backgroundTint="@color/warning"
                android:layout_marginEnd="8dp"
                style="@style/Widget.Material3.Button.OutlinedButton"/>

            <Button
                android:id="@+id/btnImmediateReport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="立即上报数据"
                android:backgroundTint="@color/primary"
                style="@style/Widget.Material3.Button.OutlinedButton"/>

        </LinearLayout>

        <!-- ✅ 新增：后台保活测试邮件控制 -->
<androidx.cardview.widget.CardView
    android:id="@+id/cardDeveloperTestEmail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="后台保活测试邮件"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="开启后台定时测试"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDeveloperTestEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <!-- 时间间隔设置 -->
        <LinearLayout
            android:id="@+id/layoutTestEmailInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="发送时间间隔（分钟）"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etTestEmailInterval"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="30"
                    android:hint="分钟"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="分钟"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginStart="8dp"/>

                <Button
                    android:id="@+id/btnSetInterval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="设置"
                    android:layout_marginStart="16dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>

            </LinearLayout>

            <!-- 快速预设按钮 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnInterval5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 分钟"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.TonalButton"/>

                    <Button
                        android:id="@+id/btnInterval15"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15 分钟"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp"
                        style="@style/Widget.Material3.Button.TonalButton"/>

                    <Button
                        android:id="@+id/btnInterval30"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 分钟"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp"
                        style="@style/Widget.Material3.Button.TonalButton"/>

                    <Button
                        android:id="@+id/btnInterval60"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 小时"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp"
                        style="@style/Widget.Material3.Button.TonalButton"/>

                    <Button
                        android:id="@+id/btnInterval120"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 小时"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp"
                        style="@style/Widget.Material3.Button.TonalButton"/>

                </LinearLayout>

            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="当前设置：30 分钟（可调整范围：1-1440 分钟）"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvDeveloperLastTestEmailTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="上次发送：从未"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>

        <!-- ✅ 新增：日志查看卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="系统日志查看"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="查看睡眠监测、邮件发送等关键服务的运行日志"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnViewLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="查看日志"
                    android:textSize="14sp"
                    style="@style/Widget.Material3.Button.TonalButton"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ✅ 新增：睡眠快照记录查看 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="睡眠快照记录"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="查看睡前数据快照，用于跨天活动数据计算"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnViewSleepSnapshots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="查看快照记录"
                    android:textSize="14sp"
                    style="@style/Widget.Material3.Button.TonalButton"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ✅ 新增：无声音乐频率测试 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="无声音乐频率测试"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="测试不同采样率的无声音频播放（用于保活）"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="12dp"/>

                <!-- 当前状态显示 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="当前状态："
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/tvSilentMusicStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未运行"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/error"/>

                </LinearLayout>

                <!-- 频率选择按钮 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="选择采样率："
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp"/>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="3"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btnFreq8k"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="8 kHz"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.TonalButton"/>

                    <Button
                        android:id="@+id/btnFreq11k"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="11.025 kHz"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.TonalButton"/>

                    <Button
                        android:id="@+id/btnFreq16k"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="16 kHz"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.TonalButton"/>

                    <Button
                        android:id="@+id/btnFreq22k"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="22.05 kHz"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.TonalButton"/>

                    <Button
                        android:id="@+id/btnFreq32k"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="32 kHz"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.TonalButton"/>

                    <Button
                        android:id="@+id/btnFreq44k"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="44.1 kHz (默认)"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.TonalButton"/>

                </GridLayout>

                <!-- 控制按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal">

                    <Button
                        android:id="@+id/btnStartSilentMusic"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="启动"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="@color/primary"
                        style="@style/Widget.Material3.Button"/>

                    <Button
                        android:id="@+id/btnStopSilentMusic"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="停止"
                        android:layout_marginStart="8dp"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="提示：较低采样率更省电，但可能影响保活效果"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="8dp"
                    android:gravity="center"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 后台存活计时器卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="后台存活计时器"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>

                <!-- 计时器显示 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvTimerValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00:00"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:fontFamily="monospace"/>

                </LinearLayout>

                <!-- 控制按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal">

                    <Button
                        android:id="@+id/btnStartTimer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="启动"
                        android:layout_marginEnd="4dp"
                        style="@style/Widget.Material3.Button"/>

                    <Button
                        android:id="@+id/btnStopTimer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="停止"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>

                    <Button
                        android:id="@+id/btnResetTimer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="重置"
                        android:layout_marginStart="4dp"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="计时器在应用切到后台后继续运行，记录应用存活时间"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="12dp"
                    android:gravity="center"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>