<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#F5F5F5"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp">

        <!-- 警报类型图标 -->
        <FrameLayout
            android:id="@+id/flAlertIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_emergency_icon">

            <ImageView
                android:id="@+id/ivAlertType"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_dialog_alert"
                android:tint="@color/primary"
                android:contentDescription="警报类型"/>

        </FrameLayout>

        <!-- 警报信息 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <!-- 标题行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvAlertTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="紧急警报"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <View
                    android:id="@+id/viewUnreadDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_unread_dot"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="02-14 10:30"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- 摘要信息 -->
            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="收到紧急求助信号，请立即确认被守护人安全状态。"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.4"
                android:maxLines="2"
                android:ellipsize="end"/>

            <!-- 数据标签 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingTop="16dp"
                android:orientation="horizontal"
                android:background="@null">

                <TextView
                    android:id="@+id/tvStepCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="步数：120"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:textStyle="bold"
                    android:layout_marginEnd="24dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvUsageMinutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="使用：45分钟"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:textStyle="bold"
                    android:visibility="gone"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
