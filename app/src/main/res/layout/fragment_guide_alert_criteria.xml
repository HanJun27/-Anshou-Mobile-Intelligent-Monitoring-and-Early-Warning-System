<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择报警判断标准"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="系统将根据以下哪种方式判断是否需要报警？"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="20dp"/>

                <RadioGroup
                    android:id="@+id/radioGroupCriteria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioStep"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="步数检测\n通过检测您的活动步数判断安全状态"
                        android:textSize="15sp"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp"/>

                    <RadioButton
                        android:id="@+id/radioUsage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="设备使用时长检测\n通过检测您使用手机的时长判断安全状态"
                        android:textSize="15sp"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp"/>

                    <RadioButton
                        android:id="@+id/radioMixed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="混合模式（推荐）\n同时使用步数和设备使用时长进行综合判断"
                        android:textSize="15sp"
                        android:padding="12dp"
                        android:checked="true"/>

                </RadioGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>