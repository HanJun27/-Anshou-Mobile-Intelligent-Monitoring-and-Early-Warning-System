<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/draggableArea"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:layout_gravity="center_horizontal">

        <!-- 标题栏 -->
        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:background="#FF6B6B">

            <!-- 拖动提示图标 -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:contentDescription="可拖动区域"
                android:alpha="0.8"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvStepTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="第 X 步：XXX"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnCloseGuide"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="关闭"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TextButton"/>

        </LinearLayout>

        <!-- 配图区域 -->
        <ImageView
            android:id="@+id/ivGuideImage"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:contentDescription="操作指引示意图"
            android:visibility="gone"/>

        <!-- 文字说明 -->
        <TextView
            android:id="@+id/tvStepDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="详细说明文字..."
            android:textSize="13sp"
            android:textColor="#212529"
            android:lineSpacingExtra="4dp"/>

        <!-- 下一步按钮 -->
        <Button
            android:id="@+id/btnNextStep"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_margin="12dp"
            android:text="我已了解，继续下一步"
            android:textAllCaps="false"
            android:textSize="13sp"
            style="@style/Widget.Material3.Button"/>

    </LinearLayout>

</FrameLayout>
