<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 警报类型 -->
        <TextView
            android:id="@+id/tvDetailAlertType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="紧急警报"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <!-- 时间戳 -->
        <TextView
            android:id="@+id/tvDetailTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="2024-01-01 12:00:00"
            android:textSize="14sp"
            android:textColor="@color/text_hint"/>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider"/>

        <!-- 用户自定义消息 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="自定义消息"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"/>

        <TextView
            android:id="@+id/tvDetailUserMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="#F5F5F5"
            android:text="这是用户自定义的紧急消息内容"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:minHeight="60dp"/>

        <!-- 数据信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDetailStepCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_data_tag"
                android:padding="12dp"
                android:gravity="center"
                android:text="100 步"
                android:textSize="14sp"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/tvDetailUsageMinutes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_data_tag"
                android:padding="12dp"
                android:gravity="center"
                android:text="30 分钟"
                android:textSize="14sp"
                android:textColor="@color/text_primary"/>

        </LinearLayout>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider"/>

        <!-- 完整内容 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="完整内容"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"/>

        <TextView
            android:id="@+id/tvDetailFullContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="完整的邮件内容..."
            android:textSize="14sp"
            android:textColor="@color/text_primary"/>

    </LinearLayout>

</ScrollView>
