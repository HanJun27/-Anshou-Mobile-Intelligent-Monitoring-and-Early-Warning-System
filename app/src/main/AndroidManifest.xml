<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ========== 权限声明 ========== -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
    
    <!-- ✅ 悬浮窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ✅ 时光胶囊附件相关权限 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />
    
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiveWell"
        android:usesCleartextTraffic="true">
        
        <!-- 注意：如果使用 PNG 图标，需要删除或修改 mipmap-anydpi 中的 XML 配置文件 -->
        
        <!-- ========== Activity ========== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".AlertHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.LiveWell"/>
        
        <!-- 设置引导 Activity -->
        <activity
            android:name=".SettingsGuideActivity"
            android:exported="false"
            android:theme="@style/Theme.LiveWell"/>
        
        <!-- 时光胶囊设置 Activity -->
        <activity
            android:name=".TimeCapsuleSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.LiveWell"/>
        
        <!-- 密码书查看 Activity -->
        <activity
            android:name=".PasswordBookViewActivity"
            android:exported="false"
            android:theme="@style/Theme.LiveWell"/>
        
        <!-- 图片查看器 Activity -->
        <activity
            android:name=".ImageViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar"/>
        
        <!-- 功能设置 Activity -->
        <activity
            android:name=".FunctionSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.LiveWell"/>
        
        <!-- ========== Service ========== -->
        <service
            android:name=".service.CheckinService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        
        <service
            android:name=".service.EmailReceiverService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        
        <service
            android:name=".service.SleepMonitorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".service.KeepAliveChecker"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".service.BackgroundTimerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

            <!-- ✅ 测试邮件服务 -->
<service
    android:name=".service.TestEmailService"
    android:enabled="true"
    android:exported="false"
    android:foregroundServiceType="dataSync" />

        <service
            android:name=".service.KeepAliveJobService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

            <service
    android:name=".service.UnifiedNotificationService"
    android:enabled="true"
    android:exported="false"
    android:foregroundServiceType="dataSync" />

        <!-- ✅ 无声音乐播放保活服务 -->
        <service
            android:name=".service.SilentMusicService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

             <!-- ✅ 社区数据上报服务 -->
        <service
            android:name=".service.CommunityReportService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        
        <!-- ✅ 辅助功能保活服务 -->
        <service
            android:name=".service.AccessibilityKeepAliveService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        
        <!-- ✅ 邮箱配置悬浮窗指引服务 -->
        <service
            android:name=".service.EmailGuideOverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/email_guide_accessibility_config" />
        </service>
        
        <!-- ========== BroadcastReceiver ========== -->
        <!-- 开机启动接收器（合并为一个） -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.huawei.android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        
        <!-- 短信发送状态接收器 -->
        <receiver
            android:name=".receiver.SmsSentReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="SMS_SENT" />
            </intent-filter>
        </receiver>
        
        <!-- 警报确认接收器 -->
        <receiver
            android:name=".receiver.AlertConfirmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="CONFIRM_ALERT" />
                <action android:name="SNOOZE_ALERT" />
            </intent-filter>
        </receiver>

        <!-- ✅ 添加每日步数重置接收器 -->
<receiver
    android:name=".receiver.DailyStepResetReceiver"
    android:enabled="true"
    android:exported="false">
    <intent-filter>
        <action android:name="com.livewell.ACTION_RESET_DAILY_STEPS" />
    </intent-filter>
</receiver>
        
        <!-- 警报检查接收器（AlarmManager 触发） -->
        <receiver 
            android:name=".receiver.AlertReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.livewell.ALERT_CHECK"/>
            </intent-filter>
        </receiver>
        
        <!-- ✅ FileProvider for camera -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>